{
  "name": "Klaude",
  "version": "1.0.0",
  "description": "Professional Interview Assistant with Invisible Screen Overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --no-sandbox --disable-gpu",
    "test-speech": "node test-azure-speech.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "clean": "rm -rf dist/",
    "rebuild": "npm run clean && npm run build",
    "release": "npm run clean && npm run build:all",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "electron-builder --mac",
    "dist:mac-arm": "electron-builder --mac --arm64",
    "dist:mac-x64": "electron-builder --mac --x64",
    "dist:win": "electron-builder --win",
    "dist:all": "npm run dist:mac-arm && npm run dist:mac-x64 && npm run dist:win -- --publish always"
  },
  "author": "Klaude Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.3.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.2.0",
    "markdown": "^0.5.0",
    "marked": "^15.0.12",
    "node-record-lpcm16": "^1.0.1",
    "nodejs-whisper": "^0.2.9",
    "tesseract.js": "^6.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.klaude.app",
    "productName": "Klaude",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!*.md",
      "!.git/**/*",
      "!.env*",
      "resources/**/*"
    ],
    "extraFiles": [
      {
        "from": "prompts",
        "to": "prompts"
      }
    ],
    "asarUnpack": [
      "node_modules/**/*",
      "node_modules/nodejs-whisper/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/tesseract.js-core/**/*",
      "resources/**/*",
      "eng.traineddata",
      "node_modules/tesseract.js/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icons/appIcon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assests/icons/appIcon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "certificateFile": null,
      "certificatePassword": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Klaude"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "extraResources": [
      {
        "from": "resources/whisper/macos-arm64",
        "to": "whisper/macos-arm64",
        "filter": [
          "whisper-cli",
          "ggml-base.en.bin"
        ]
      },
      {
        "from": "resources/sox/macos-arm64",
        "to": "sox/macos-arm64",
        "filter": [
          "sox"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "3legends",
      "repo": "Klaude-AI-Assistant",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseNotes": "Bug fixes and performance improvements."
    }
  }
}
