# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Whisper Speech Recognition Configuration
# Model options: tiny.en, base.en (RECOMMENDED), small.en, medium.en, large
# Smaller = faster, Larger = more accurate
# For interviews, base.en is perfect (140MB, ~2-3 sec per 30sec audio)
WHISPER_MODEL=base.en

# GPU acceleration (if you have NVIDIA GPU with CUDA)
# Set to true to enable, false for CPU only
WHISPER_GPU=true